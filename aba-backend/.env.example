# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aba_platform?schema=public"

# For local development, use SQLite:
# DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="change-this-to-a-random-secret-at-least-32-chars-long"
JWT_REFRESH_SECRET="change-this-to-another-random-secret-at-least-32-chars-long"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Encryption
ENCRYPTION_KEY="change-this-to-a-32-char-key-for-aes-256"
