# ─── Production environment (set these on Render, NOT in a committed file) ───
PORT=3001
NODE_ENV=production

# Postgres connection string from Neon (https://neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT secrets — generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string-32-chars-min"
JWT_REFRESH_SECRET="replace-with-another-long-random-string-32-chars-min"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# The deployed frontend URL (Vercel)
CORS_ORIGIN="https://your-app.vercel.app"

# AES-256 encryption key — exactly 32 characters
ENCRYPTION_KEY="12345678901234567890123456789012"

# ─── Stripe (subscriptions) — use LIVE keys in production ───────────────
STRIPE_SECRET_KEY="sk_live_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
# Price IDs created in the Stripe Dashboard for each tier/cycle
STRIPE_PRICE_BASIC_MONTHLY="price_xxx"
STRIPE_PRICE_BASIC_ANNUAL="price_xxx"
STRIPE_PRICE_PRO_MONTHLY="price_xxx"
STRIPE_PRICE_PRO_ANNUAL="price_xxx"
STRIPE_PRICE_ENTERPRISE_MONTHLY="price_xxx"
STRIPE_PRICE_ENTERPRISE_ANNUAL="price_xxx"
